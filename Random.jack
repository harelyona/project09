// Simple random number generator
class Random {
    field int seed;

    // Create new random generator
    constructor Random new() {
        return this;
    }

    // Set the seed value for randomization
    method void setSeed(int seed) {
        let seed = seed;
        return;
    }
    // Generate random number between 0 and max-1
    method int random(int max) {
        var int mask;
        var int ret;
        let seed = (seed * 237) + 51;
        let ret = seed - (max * (seed / max));
        if (ret < 0) {
            let ret = ret + max;
        }

        return ret;
    }
    // Free memory
    method void dispose() {
        do Memory.deAlloc(this);
        return;
    }
}