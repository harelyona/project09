/**
  * In Jack programs, the first function that runs is always the function "main"
  * from the class "Main".
  * You can include as many classes and functions as you want.
  */

// Main entry point for Hangman game
class Main {
  
  function void main() {
    var Random random;
    var Game game;
    let game = Game.new();
    do game.startGame();
    do game.dispose();
    do Sys.halt();
    return;
  }
}
