// Main game logic for Hangman
class Game {
    field int numberOfTries, guessesMade, seed;
    field String finalWord, curWord, guessedLetters;
    field Random random;
    field WordStorage wordsStorage;
    field boolean gameWon, playAgain;
    field char guessedChar;
    field HangmanDrawer drawer;
    
    // NEW: Track if clue has been used
    field boolean clueUsed;

    // Initialize game with max number of tries
    constructor Game new(int nTries) {
        let numberOfTries = nTries;
        let guessesMade = 0;
        let random = Random.new();
        let wordsStorage = WordStorage.new();
        let gameWon = false;
        let playAgain = true;
        let guessedLetters = String.new(26);
        let drawer = HangmanDrawer.new();
        
        let clueUsed = false; // Initialize clue usage

        return this;
    }

    // Main game loop
    method void startGame() {
        do greeting();
        do Screen.clearScreen();
        while (playAgain) {
            do resetGame();
            do play();
            let playAgain = endGameScreen();
            do Sys.wait(1500);
        }
        do Output.printString("Thanks for playing! Goodbye.");
        do Output.println();
        return;
    }

    // Reset game state for new round
    method void resetGame() {
        var int randomNumber;
        let guessesMade = 0;
        let gameWon = false;
        
        // NEW: Reset clue for the new round
        let clueUsed = false;

        if (~(guessedLetters = 0)) { 
            do guessedLetters.dispose();
        }
        let guessedLetters = String.new(26);

        let randomNumber = random.random(wordsStorage.getWordCount());
        let finalWord = wordsStorage.getWord(randomNumber);
        do initializeScreen();
        return;
    }
    
    // Display welcome message and get seed
    method void greeting() {
        do Output.printString("Welcome to the Guessing Game!");
        do Output.println();
        do Output.printString("Try to guess the word in ");
        do Output.printInt(numberOfTries);
        do Output.printString(" tries.");
        do Output.println();
        do Output.printString("Type 'clue' to reveal one letter (once per game)."); 
        do Output.println();
        let seed = Keyboard.readInt("Enter a seed number: ");
        do random.dispose();
        let random = Random.new();
        do Screen.clearScreen();
        do Output.moveCursor(0, 0);
        return;
    }

    // Setup screen with blank word
    method void initializeScreen() {
        var int wordLen, i;
        let wordLen = finalWord.length();
        
        do Screen.clearScreen();
        do Output.moveCursor(0, 0);
        if (~(curWord = 0)) { 
            do curWord.dispose(); 
        }

        let curWord = String.new(wordLen);
        
        let i = 0;
        while (i < wordLen) {
            do curWord.appendChar(95); // '_'
            let i = i + 1;
        }
        do drawer.reset();
        return;
    }

    // Main gameplay loop
    method void play() {
        while ( (guessesMade < numberOfTries) & (~gameWon) ) { 
            do drawGame();
            do getInput();
            do processGuess();
        }
        return;
    }

    // Draw current game state
    method void drawGame() {
        var int triesRemaining;
        do Screen.clearScreen();
        do Output.moveCursor(0, 0);
        do Output.printString("Current Word: ");
        do Output.printString(curWord);
        do Output.println();

        do Output.printString("Guessed Letters: ");
        do Output.printString(guessedLetters);
        do Output.println();

        let triesRemaining = numberOfTries - guessesMade;
        do Output.printString("Tries Remaining: ");
        do Output.printInt(triesRemaining);
        do Output.println();
        if (clueUsed) {
             do Output.printString("Clue: USED");
        } else {
             do Output.printString("Clue: AVAILABLE (type 'clue')");
        }
        do Output.println();

        do drawer.draw(guessesMade);
        return;
    }

    method void getInput() { 
        // Get and validate letter input from user
        var String input;
        var boolean validInput;
        var char tempChar;
        var char c0, c1, c2, c3;
        
        let validInput = false;
        while (~validInput) {
            let input = Keyboard.readLine("Guess a letter: ");
            if (input.length() = 4) {
                let c0 = input.charAt(0);
                let c1 = input.charAt(1);
                let c2 = input.charAt(2);
                let c3 = input.charAt(3);

                // Check "clue" (99, 108, 117, 101) OR "CLUE" (67, 76, 85, 69)
                if ( ((c0 = 99) | (c0 = 67)) & ((c1 = 108) | (c1 = 76)) & ((c2 = 117) | (c2 = 85)) & ((c3 = 101) | (c3 = 69)) ) { 
                     if (clueUsed) {
                         do Output.printString("You have already used your clue!");
                         do Output.println();
                     } else {
                         do giveClue();
                         let validInput = true;
                     }
                } else {
                    do Output.printString("Invalid input.");
                    do Output.println();
                }
            } else {
                if (checkInputValidity(input)) {
                    let tempChar = input.charAt(0);
                    if ((tempChar > 64) & (tempChar < 91)) { 
                        let tempChar = tempChar + 32;
                    }
                    let guessedChar = tempChar;
                    let validInput = true;
                }
            }
            do input.dispose();
        }
        do Output.println();
        return;
    }

    method void giveClue() {
        var int i, len;
        var char c;
        let len = finalWord.length();
        let i = 0;
        while (i < len) {
            if (curWord.charAt(i) = 95) { // 95 is '_'
                let guessedChar = finalWord.charAt(i);
                let clueUsed = true;
                do Output.printString("Clue used! The letter is: ");
                do Output.printChar(guessedChar);
                do Output.println();
                return;
            }
            let i = i + 1;
        }
        return;
    }

    method boolean checkInputValidity(String input) {
        // Validate that input is a single letter and not already guessed
        var char c;
        var char tempChar;
        var int index;
        var boolean alreadyGuessed;
        
        if (~(input.length() = 1)) {
            do Output.printString("Please enter a single character.");
            do Output.println();
            return false;
        }

        let c = input.charAt(0);
        
        if (((c > 64) & (c < 91)) | ((c > 96) & (c < 123))) { // Check for letter
            
            let tempChar = c; 
            
            if ((tempChar > 64) & (tempChar < 91)) {
                let tempChar = tempChar + 32; // Convert to lowercase
            }
            
            let alreadyGuessed = isContainChar(guessedLetters, tempChar);
            if (alreadyGuessed) {
                do Output.printString("You already guessed the letter ");
                do Output.printChar(tempChar);
                do Output.printString(". Try another one.");
                do Output.println();
                return false;
            }
            
            return true;
        }
        
        do Output.printString("Please enter a letter");
        do Output.println();
        return false;
    }

    // Process the guessed letter
    method void processGuess() {
        var boolean letterFound;
        var int i;
        var int wordLength;

        do guessedLetters.appendChar(guessedChar); 

        let letterFound = false;
        let wordLength = finalWord.length();
        let i = 0;

        while (i < wordLength) {
            if (finalWord.charAt(i) = guessedChar) {

                do curWord.setCharAt(i, guessedChar);
                let letterFound = true;
            }
            let i = i + 1;
        }

        if (~letterFound) {
            let guessesMade = guessesMade + 1;
        }

        let gameWon = checkWin();

        return;
    }

    // Check if player has won
    method boolean checkWin() {
        var int i, wordLength;
        var char currentChar;
        let i = 0;
        let wordLength = finalWord.length();
        while (i < wordLength) {
            let currentChar = curWord.charAt(i);
            if (currentChar = 95) { // If we find an underscore
                return false;
            }
            let i = i + 1;
        }
        return true;
    }

    // Display end game message and ask to play again
    method boolean endGameScreen() {
    var String input; 
    var char response;
    do drawer.draw(guessesMade);
    if (gameWon) {
        do Output.printString("Congratulations! You've guessed the word: ");
        do Output.printString(finalWord);
        do Output.println();
    } else {
        do Output.printString("Game Over! You've used all your tries.");
        do Output.println();
        do Output.printString("The word was: ");
        do Output.printString(finalWord);
        do Output.println();
    }
    let input = Keyboard.readLine("Play again? (y/n): ");
    while (~playAgainInputValidity(input)) {
        do input.dispose();
        do Output.moveCursor(0, 0);
        do Screen.clearScreen();
        do drawer.draw(guessesMade);
        do Output.printString("Please enter a single character 'y' or 'n': ");
        let input = Keyboard.readLine("");
    }
    let response = input.charAt(0);
    do input.dispose();
    do Output.println();

    if ((response=121) | (response=89)) { // 'y' or 'Y' 
        do Output.printString("Starting a new game...");
        do Output.println();
        return true; 
    }
    
    return false;
    }

    // Validate play again input
    method boolean playAgainInputValidity(String input) {
    var char c;

    if (~(input.length() = 1)) {
        return false;
    }
    let c = input.charAt(0);
    if ((c=121) | (c=89) | (c=110) | (c=78)) {// 'y','Y','n','N'
        return true;
        }
    return false;
    }

    // Check if string contains character
    method boolean isContainChar(String str, char c) {
        var int i, len;
        let len = str.length();
        let i = 0;
        while (i < len) {
            if (str.charAt(i) = c) {
                return true;
            }
            let i = i + 1;
        }
        return false;
    }
        
    //Free memory
    method void dispose() {
        do random.dispose();
        do drawer.dispose();
        do wordsStorage.dispose();
        if (~(curWord = null)) { do curWord.dispose(); }

        if (~(guessedLetters = 0)) { do guessedLetters.dispose(); }
        
        do Memory.deAlloc(this);
        return;
    }
}