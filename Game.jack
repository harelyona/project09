class Game {
    field int numberOfTries;
    field int guessesMade;
    field String finalWord;
    field String curWord;
    field int seed;
    field Random random;
    field WordStorage wordsStorage;
    field boolean gameWon;
    field char guessedChar;
    field boolean playAgain;

    constructor Game new(int nTries) {
        let numberOfTries = nTries;
        let guessesMade = 0;
        let random = Random.new();
        let wordsStorage = WordStorage.new();
        let gameWon = false;
        let playAgain = true;
        return this;
    }

    method void startGame() {
        do greeting();
        do Screen.clearScreen();
        while (playAgain) {
            do resetGame();
            do play();
            let playAgain = endGameScreen();
            do Sys.wait(2000);
        }
        do Output.printString("Thanks for playing! Goodbye.");
        do Output.println();
        return;
    }

    method void resetGame() {
        var int randomNumber;
        let guessesMade = 0;
        let gameWon = false;
        let randomNumber = random.random(wordsStorage.getWordCount());
        let finalWord = wordsStorage.getWord(randomNumber);
        do initializeScreen();
        return;
    }
    
    method void greeting() {
        do Output.printString("Welcome to the Guessing Game!");
        do Output.println();
        do Output.printString("Try to guess the word in ");
        do Output.printInt(numberOfTries);
        do Output.printString(" tries.");
        do Output.println();
        let seed = Keyboard.readInt("Enter a seed number: ");
        do random.dispose();
        let random = Random.new();
        do Screen.clearScreen();
        do Output.moveCursor(0, 0);
        return;
    }

    method void initializeScreen() {
        var int wordLen;
        var int i;
        let wordLen = finalWord.length();
        
        do Screen.clearScreen();
        do Output.moveCursor(0, 0);
        //0 is null. If curWord isn't 0, it points to an existing string.
        if (~(curWord = 0)) { 
            do curWord.dispose(); 
        }

        let curWord = String.new(wordLen);
        
        let i = 0;
        while (i < wordLen) {
            do curWord.appendChar(95); // '_'
            let i = i + 1;
        }
        return;
    }

    method void play() {
        while ( (guessesMade < numberOfTries) & (~gameWon) ) { 
            do drawGame();
            do getInput(); 
            do processGuess();
        }
        return;
    }

    method void drawGame() {
        var int triesRemaining;
        do Screen.clearScreen();
        do Output.moveCursor(0, 0);
        do Output.printString("Current Word: ");
        do Output.printString(curWord);
        do Output.println();
        let triesRemaining = numberOfTries - guessesMade;
        do Output.printString("Tries Remaining: ");
        do Output.printInt(triesRemaining);
        do Output.println();
        return;
    }

    method void getInput() {
        var String input;
        var boolean validInput;
        
        let validInput = false;
        while (~validInput) {
            let input = Keyboard.readLine("Guess a letter: ");
            if (checkInputValidity(input)) {
                let guessedChar = input.charAt(0);
                let validInput = true;
            }
            do input.dispose();
        }
        do Output.println();
        return;
    }

    method boolean checkInputValidity(String input) {
        var char c;
        if (~(input.length() = 1)) {
            do Output.printString("Please enter a single character.");
            do Output.println();
            return false;
        }
        let c = input.charAt(0);
        if (((c > 64) & (c < 91)) | ((c > 96) & (c < 123))) { // Check for letter
            return true;
        }
        do Output.printString("Please enter a letter");
        do Output.println();
        return false;
    }

    method void processGuess() {
        var int i;
        var int wordLength;
        var boolean correctGuess;
        let wordLength = finalWord.length();
        let i = 0;
        let correctGuess = false;

        while (i < wordLength) {
            if (finalWord.charAt(i) = guessedChar) {
                do curWord.setCharAt(i, guessedChar); 
                let correctGuess = true;
            }
            let i = i + 1;
        }

        if (~correctGuess) {
            let guessesMade = guessesMade + 1;
        }
        let gameWon = checkWin();
        return;
    }

    method boolean checkWin() {
        var int i, wordLength;
        var char currentChar;
        let i = 0;
        let wordLength = finalWord.length();
        while (i < wordLength) {
            let currentChar = curWord.charAt(i);
            if (currentChar = 95) { // If we find an underscore
                return false;
            }
            let i = i + 1;
        }
        return true;
    }

    method boolean endGameScreen() {
    var String input; 
    var char response;
    
    do Output.printString("The word was: ");
    do Output.printString(finalWord);
    do Output.println();
    let input = Keyboard.readLine("Play again? (y/n): ");
    while (~playAgainInputValidity(input)) {
        do input.dispose();
        do Output.printString("Please enter a single character 'y' or 'n': ");
        let input = Keyboard.readLine("");
    }
    let response = input.charAt(0);
    do input.dispose();
    do Output.println();

    if ((response=121) | (response=89)) { // 'y' or 'Y' 
        do Output.printString("Starting a new game...");
        do Output.println();
        return true; 
    }
    
    return false;
    }
    
    method void dispose() {
        do random.dispose();
        do wordsStorage.dispose();
        if (~(curWord = null)) { do curWord.dispose(); }
        do Memory.deAlloc(this);
        return;
    }

    method boolean playAgainInputValidity(String input) {
    var char c;

    if (~(input.length() = 1)) {
        return false;
    }
    let c = input.charAt(0);
    if ((c=121) | (c=89) | (c=110) | (c=78)) {// 'y','Y','n','N'
        return true;
        }
    return false;
    }
}