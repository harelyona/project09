    // Get word at given index (0-249)
    method String getWord(int index) {
        return words[index];
    }

    // Return total word count
    method int getWordCount() {
        return wordCount;
    }

    // Free memory
    method void dispose() {
        var int i;
        var String currentWord;
        
        let i = 0;
        while (i < wordCount) {
            let currentWord = words[i];
            if (~(currentWord = null)) {
                do currentWord.dispose();
            }
    
            let i = i + 1;
        }
        do words.dispose();
        do Memory.deAlloc(this);
        
        return;
    }
}