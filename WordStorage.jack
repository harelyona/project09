    method String getWord(int index) {
        return words[index];
    }

    method int getWordCount() {
        return wordCount;
    }

    method void dispose() {
        var int i;
        var String currentWord;
        
        let i = 0;
        while (i < wordCount) {
            let currentWord = words[i];
            if (~(currentWord = null)) {
                do currentWord.dispose();
            }
    
            let i = i + 1;
        }
        do words.dispose();
        do Memory.deAlloc(this);
        
        return;
    }
}